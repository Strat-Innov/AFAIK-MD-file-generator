node_modules/
dist/

# Real exported SharePoint pages used as test fixtures and as the
# standing regression corpus. They contain employee names, work email
# addresses and internal tenant URLs, and this repository is public —
# keep them local. See test/fixtures/README.md and test/corpus/README.md.
test/fixtures/*.aspx
test/corpus/*.aspx

# Generated retrieval question set. Ground-truth answers include employee
# names and work email addresses drawn from the corpus, and this
# repository is public — the generator is committed, its output is not.
# See benchmark/README.md.
benchmark/question-set.json
benchmark/question-set.md

# Benchmark knowledge artifacts (Arm B / Arm C) built from the corpus by
# `npm run benchmark:arms`. They reproduce the corpus content, including
# employee names, work email addresses and internal tenant URLs, and this
# repository is public — the builder is committed, its output is not.
# See benchmark/README.md.
benchmark-artifacts/

# Resolved benchmark scope manifest (bucket -> page filenames). Page
# names disclose the internal site structure and this repository is
# public — same reasoning as the question set above. See benchmark/SCOPE.md.
benchmark/scope-128.json
